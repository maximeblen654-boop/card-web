# Default deny: only reviewed source and build instructions enter Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/upstream.lock.json
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
!/scripts/
/scripts/*
!/scripts/*.mjs
!/scripts/*.sh
!/local-shop/
/local-shop/*
!/local-shop/Start-LocalShop.ps1
!/local-shop/Stop-LocalShop.ps1
!/local-shop/启动测试商城.cmd
!/local-shop/停止测试商城.cmd
!/local-shop/使用说明.txt
!/local-shop/testing/
/local-shop/testing/*
!/local-shop/testing/*.mjs

# Local state, credentials, purchased material and build products stay local.
**/runtime/
**/backups/
**/node_modules/
**/.env*
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pem
**/*.key
**/*.log
**/*.zip
**/*.exe
